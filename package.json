{
  "name": "fnlink",
  "version": "1.3.7",
  "private": true,
  "description": "PC-клиент микро-мессенджера",
  "author": "TechMagicInfinity <my-email@email.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/TechMagicInfinity13/FNLink.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dist": "electron-builder --publish=never",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron": "^44.7.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron-builder": "^26.13.0"
  },
  "build": {
    "appId": "com.techmagicinfinity.fnlink",
    "productName": "FNLink",
    "files": [
      "**/*",
      "!**/node_modules/electron-builder${/*}",
      "!mobile/**"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "TechMagicInfinity13",
      "repo": "FNLink",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "toolsets": {
      "appimage": "1.0.3"
    }
  }
}
